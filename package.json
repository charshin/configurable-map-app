{
  "name": "nextjs-conf-map",
  "private": true,
  "description": "Saved map configurations: Next.js web app (BFF) + NestJS API, managed with Turborepo.",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
